{
  "name": "a3-cli",
  "version": "1.0.1",
  "description": "AtCoder でACしたソースコードをGitHub上 or ローカルに保存します",
  "type": "module",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "a3": "./lib/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": {
    "name": "ivgtr",
    "email": "ivgtr.me@gmail.com",
    "url": "https://github.com/ivgtr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivgtr/atcoder-ac-archive.git"
  },
  "homepage": "https://github.com/ivgtr/atcoder-ac-archive#readme",
  "bugs": {
    "url": "https://github.com/ivgtr/atcoder-ac-archive/issues"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "lib"
  ],
  "scripts": {
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --test tests/__tests__/*.test.ts tests/__tests__/commands/*.test.ts",
    "workflow": "node --loader ts-node/esm ./src/index.ts",
    "watch": "tsc -w",
    "dev:workflow": "node --loader ts-node/esm ./src/index.ts",
    "dev:cli": "node --loader ts-node/esm ./src/cli.ts",
    "type-check": "tsc --noEmit",
    "prebuild": "node -e 'fs.rmSync(`lib`, {recursive:true, force:true})'",
    "build": "rollup -c && tsc --emitDeclarationOnly -p tsconfig-build.json",
    "format": "prettier -w ./src/*",
    "lint": "biome lint src",
    "prepare": "is-ci || husky install"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@biomejs/biome": "2.6.4",
    "@rollup/plugin-babel": "5.3.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-replace": "3.1.0",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "18.19.130",
    "@types/prompts": "2.0.14",
    "@types/update-notifier": "6.0.9",
    "husky": "6.0.0",
    "lint-staged": "12.4.1",
    "prettier": "2.6.2",
    "rollup": "2.80.0",
    "rollup-plugin-auto-external": "2.0.0",
    "rollup-plugin-node-externals": "3.1.2",
    "rollup-plugin-preserve-shebang": "1.0.1",
    "rollup-plugin-visualizer": "5.6.0",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "1.21.0",
    "cheerio": "1.0.0-rc.10",
    "commander": "8.3.0",
    "dotenv": "10.0.0",
    "lang2extension": "0.1.4",
    "lowdb": "3.0.0",
    "open": "8.4.0",
    "ora": "6.1.0",
    "prompts": "2.4.2",
    "simple-git": "4.0.2",
    "update-notifier": "7.3.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write"
    ]
  }
}
